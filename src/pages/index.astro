---
import BaseLayout from "../layouts/BaseLayout.astro";
import TapeLabel from "../components/field/TapeLabel.astro";
import HandNote from "../components/field/HandNote.astro";
import Sticker from "../components/field/Sticker.astro";
import Doodle from "../components/field/Doodle.astro";
import { socials } from "../data/socials";
import { getCollection } from "astro:content";

const guides = (await getCollection("guides", ({ data }) => !data.draft))
	.sort((a, b) => a.data.order - b.data.order);

const discord = socials.find(link => link.label === "Discord")!;

const ticker = [
	"made on the bus",
	"550+ voices",
	"clips & patterns",
	"scenes & mutes",
	"phones · tablets · desktop",
	"early access coming soon",
	"fm synths & samplers",
];

const features = [
	{
		number: "01",
		title: "Get the idea down fast",
		body: "Tap an empty slot and start playing. Loop it, then try a variation in the next slot.",
		image: "/images/application-screenshots/tracks.png",
		imageAlt: "Pooly clip launcher",
		note: "before the bus stop ♪",
	},
	{
		number: "02",
		title: "Play your song live",
		body: "Launch scenes, mute tracks, and finger drum on the pads while the song plays.",
		image: "/images/application-screenshots/arranger%20+%20launcher.png",
		imageAlt: "Pooly arranger and clip launcher",
		wide: true,
	},
	{
		number: "03",
		title: "A small studio of instruments",
		body: "Over 550 built-in voices: FM synths, samplers, drum kits, and everyday sounds.",
		image: "/images/application-screenshots/detail.png",
		imageAlt: "Pooly instrument detail view",
	},
	{
		number: "04",
		title: "Finish the song",
		body: "Lay your clips out on the timeline and export the song from the same device you started it on.",
		image: "/images/application-screenshots/launcher%20+%20detail.png",
		imageAlt: "Pooly clip launcher and instrument detail",
		note: "sketch → song",
		wide: true,
	},
];

const pics = [
	{ src: "/images/application-screenshots/project%20selection.png", alt: "Pooly project list" },
	{ src: "/images/application-screenshots/varrange%20+%20detail.png", alt: "Pooly arranger with instrument detail" },
	{ src: "/images/galaxy%20s26%20ultra.jpg", alt: "Pooly drum kit on a phone" },
];

const topFriends = [
	{ name: "lil pooly", doodle: "bad_pooly", color: "var(--color-note)" },
	{ name: "fm guy", doodle: "fm", color: "var(--color-blue)" },
	{ name: "strum", doodle: "strum", color: "var(--color-clay)" },
	{ name: "turtle", doodle: "turtle", color: "var(--color-olive)" },
	{ name: "cat?", doodle: "cat", color: "var(--color-accent)" },
	{ name: "xy!", doodle: "xy", color: "var(--color-note)" },
	{ name: "birb", doodle: "bird", color: "var(--color-blue)" },
	{ name: "♫♫", doodle: "notes", color: "var(--color-clay)" },
];

const [lilPooly, fmGuy, , turtle, cat] = topFriends;

const comments = [
	{ from: turtle, when: "4 bars ago", text: "took three bus rides but i finished the loop. thanks for the add!!" },
	{ from: cat, when: "8 bars ago", text: "walked across the pads by accident. kept it." },
	{ from: fmGuy, when: "a verse ago", text: "FM" },
	{ from: lilPooly, when: "the intro", text: "first!!!" },
];
---

<BaseLayout
	title="Pooly"
	description="A touch-first music workstation for sketching, sampling, performing, and arranging on phones, tablets, and desktop."
>
	<div class="blanket" aria-hidden="true"></div>

	<div class="profile">
		<div class="ticker" aria-hidden="true">
			<div class="ticker-track">
				{[0, 1].map(() => (
					<ul>{ticker.map(item => <li>{item}</li>)}</ul>
				))}
			</div>
		</div>

		<div class="profile-cols">
			<div class="profile-col">
				<section class="box profile-card">
					<p class="profile-name">Pooly</p>
					<div class="profile-id">
						<div class="profile-pic">
							<img src="/images/brand/pooly mascot 3d fall.png" alt="Pooly mascot" width="1024" height="759" />
							<TapeLabel rotate="-6deg" class="profile-tape">Field Studio</TapeLabel>
						</div>
						<div class="profile-facts">
							<p class="profile-headline">"sketch, loop, build."</p>
							<p>touch-first<br />music workstation<br />phones · tablets · desktop</p>
							<p class="online"><span class="online-dot" aria-hidden="true"></span>Online Now!</p>
						</div>
					</div>
					<p class="profile-line"><b>Mood:</b> looping ♪</p>
					<p class="profile-line"><b>View My:</b> <a href="/learn/">Guides</a> | <a href="/manual/">Manual</a></p>
				</section>

				<section class="box contact">
					<h2 class="box-head">Contacting Pooly</h2>
					<ul class="contact-grid">
						{socials.map(link => (
							<li>
								<a href={link.href} target="_blank" rel="noopener noreferrer">
									<span class="contact-icon" set:html={link.icon} />
									{link.label}
								</a>
							</li>
						))}
					</ul>
				</section>

				<section class="box url-box">
					<h2 class="box-head">Pooly's URL</h2>
					<p class="box-body"><a href="/">{Astro.site!.href}</a></p>
				</section>

				<section class="box blog">
					<h2 class="box-head">
						Pooly's Latest Blog Entries
						<a href="/learn/">[view all]</a>
					</h2>
					<ul class="box-body blog-list">
						{guides.map(guide => (
							<li>
								<a href={`/learn/${guide.id}/`}>{guide.data.title}</a>
								<span class="blog-meta">{guide.data.difficulty}{guide.data.estimatedTime && ` · ${guide.data.estimatedTime}`}</span>
								<a class="blog-more" href={`/learn/${guide.id}/`}>(view more)</a>
							</li>
						))}
					</ul>
				</section>

				<section class="box interests">
					<h2 class="box-head">Pooly's Interests</h2>
					<table class="info-table">
						<tr><th scope="row">General</th><td>sketching, sampling, performing, arranging</td></tr>
						<tr><th scope="row">Music</th><td>clips, patterns, variations, scenes, mutes, performance pads</td></tr>
						<tr><th scope="row">Instruments</th><td>FM synths, samplers, drum kits, everyday sounds</td></tr>
						<tr><th scope="row">Hangs out</th><td>the bus, the couch, the park, the floor</td></tr>
					</table>
				</section>

				<section class="box details">
					<h2 class="box-head">Pooly's Details</h2>
					<table class="info-table">
						<tr><th scope="row">Status</th><td>early access · coming soon</td></tr>
						<tr><th scope="row">Here for</th><td>half-finished songs</td></tr>
						<tr><th scope="row">Body type</th><td>touch-first</td></tr>
						<tr><th scope="row">Hometown</th><td>your pocket</td></tr>
						<tr><th scope="row">Voices</th><td><span class="counter"><span>0</span><span>5</span><span>5</span><span>0</span></span>+</td></tr>
					</table>
				</section>

				<section class="box pics">
					<h2 class="box-head">Pooly's Pics</h2>
					<ul class="box-body pics-grid">
						{pics.map(pic => (
							<li>
								<a href={pic.src} target="_blank" rel="noopener noreferrer">
									<img src={pic.src} alt={pic.alt} loading="lazy" />
								</a>
							</li>
						))}
						<li class="pics-sketch">
							<Doodle name="layout" color="var(--color-note)" width="92%" opacity="0.85" alt="Early sketch of the Pooly layout" />
						</li>
					</ul>
				</section>
			</div>

			<div class="profile-col">
				<section class="box network">
					<p class="network-kicker">Pooly is in your extended network</p>
					<h1>make music before the idea disappears.</h1>
					<p class="network-lead">
						Pooly is a touch-first music workstation for sketching,
						sampling, performing, and arranging on phones, tablets, and desktop.
					</p>
					<Sticker rotate="9deg" color="var(--color-olive)" class="network-sticker">Made on<br />the bus</Sticker>
				</section>

				<section class="box box-warm blurbs">
					<h2 class="box-head">Pooly's Blurbs</h2>
					<div class="box-body">
						<h3 class="blurb-label">About me:</h3>
						{features.map(feature => (
							<article class:list={["blurb-feature", { wide: feature.wide }]}>
								<div class="blurb-copy">
									<span class="blurb-number">{feature.number}</span>
									<h4>{feature.title}</h4>
									<p>{feature.body}</p>
									{feature.note && <HandNote class="blurb-note">{feature.note}</HandNote>}
								</div>
								<figure class="blurb-pic">
									<img src={feature.image} alt={feature.imageAlt} loading="lazy" />
								</figure>
							</article>
						))}

						<h3 class="blurb-label">Who I'd like to meet:</h3>
						<p class="blurb-meet">
							People with half a song stuck in their phone. People who hum into
							voice memos on the bus. Anyone who has ever lost a melody somewhere
							between the shower and the laptop.
						</p>
					</div>
				</section>

				<section class="box box-warm shows">
					<h2 class="box-head">Pooly's Upcoming Shows</h2>
					<div class="box-body">
						<table class="shows-table">
							<tr>
								<td class="shows-when">soon</td>
								<td><b>Early access</b></td>
								<td>wherever you are</td>
							</tr>
						</table>
						<div class="shows-hype">
							<p class="glitter">★ coming soon ★</p>
							<Doodle name="were" class="shows-doodle" color="var(--color-note)" width="150px" rotate="-6deg" opacity="0.8" alt="We're ready" />
						</div>
						<p class="shows-lead">Come hang out in the Discord, follow along, and tell us what you want in it.</p>
						<div class="shows-links">
							<a class="bevel" href={discord.href} target="_blank" rel="noopener noreferrer">Join the Discord</a>
							<a class="bevel" href="/learn/">Learn Pooly</a>
							<a class="bevel" href="/manual/">Manual</a>
						</div>
					</div>
				</section>

				<section class="box box-warm friends">
					<h2 class="box-head">Pooly's Friend Space</h2>
					<div class="box-body">
						<p class="friends-count">
							Pooly has <b>550+</b> friends.
							<HandNote class="friends-aside">(they're built-in voices. it counts.)</HandNote>
						</p>
						<ul class="top-friends">
							{topFriends.map(friend => (
								<li>
									<span class="friend-pic">
										<Doodle name={friend.doodle} color={friend.color} width="76%" opacity="0.9" alt="" />
									</span>
									<span class="friend-name">{friend.name}</span>
								</li>
							))}
						</ul>
					</div>
				</section>

				<section class="box box-warm comments">
					<h2 class="box-head">Pooly's Friends Comments</h2>
					<div class="box-body">
						<p class="comments-count">
							Displaying <b>{comments.length}</b> of <b>{comments.length}</b> comments
							( <a href={discord.href} target="_blank" rel="noopener noreferrer">Add Comment</a> )
						</p>
						<table class="comments-table">
							<tbody>
							{comments.map(comment => (
								<tr>
									<th scope="row">
										<span class="friend-pic">
											<Doodle name={comment.from.doodle} color={comment.from.color} width="76%" opacity="0.9" alt="" />
										</span>
										<span class="friend-name">{comment.from.name}</span>
									</th>
									<td>
										<p class="comment-when">{comment.when}</p>
										<p>{comment.text}</p>
									</td>
								</tr>
							))}
							</tbody>
						</table>
					</div>
				</section>
			</div>
		</div>
	</div>
</BaseLayout>

<style>
	/* ── Backdrop ── */

	.blanket {
		position: fixed;
		inset: 0;
		z-index: -1;
		background: var(--color-bg) url("/images/brand/poolyHero01.png") center 58% / cover no-repeat;
	}

	/* ── Page frame ── */

	.profile {
		max-width: 60rem;
		margin: 0 auto;
		padding: clamp(10rem, 38svh, 24rem) var(--space-md) var(--space-4xl);
		font-size: 0.8125rem;
		line-height: 1.5;
	}

	.profile a {
		font-weight: 700;
	}

	.profile a:hover {
		text-decoration: underline;
	}

	.profile-cols {
		display: flex;
		flex-direction: column;
		gap: var(--space-md);
	}

	.profile-col {
		display: contents;
	}

	/* One column on narrow screens: lead with the pitch */
	.network { order: 1; }
	.profile-card { order: 2; }
	.contact { order: 3; }
	.blurbs { order: 4; }
	.shows { order: 5; }
	.friends { order: 6; }
	.blog { order: 7; }
	.interests { order: 8; }
	.details { order: 9; }
	.pics { order: 10; }
	.url-box { order: 11; }
	.comments { order: 12; }

	@media (min-width: 52rem) {
		.profile-cols {
			display: grid;
			grid-template-columns: 19rem minmax(0, 1fr);
			gap: var(--space-lg);
			align-items: start;
		}

		.profile-col {
			display: flex;
			flex-direction: column;
			gap: var(--space-md);
		}

		.profile-col > * {
			order: 0;
		}
	}

	/* ── Ticker ── */

	.ticker {
		overflow: hidden;
		margin-bottom: var(--space-md);
		background: var(--color-accent);
		color: #1b120c;
		box-shadow: var(--shadow-drop);
	}

	.ticker-track {
		display: flex;
		width: max-content;
		animation: ticker 48s linear infinite;
	}

	.ticker ul {
		display: flex;
		list-style: none;
	}

	.ticker li {
		padding: 0.3rem 0 0.3rem 1.25rem;
		font-size: 0.7rem;
		font-weight: 800;
		letter-spacing: 0.12em;
		text-transform: uppercase;
		white-space: nowrap;
	}

	.ticker li::before {
		content: "★";
		margin-right: 1.25rem;
		color: var(--color-clay);
	}

	@keyframes ticker {
		to { transform: translateX(-50%); }
	}

	/* ── Boxes ── */

	.box {
		--box-tone: var(--color-blue);
		--box-ink: var(--color-text);
		--box-cell: color-mix(in srgb, var(--box-tone) 26%, var(--color-bg));
		--box-cell-soft: color-mix(in srgb, var(--box-tone) 10%, var(--color-bg));

		position: relative;
		background: color-mix(in srgb, var(--color-bg) 92%, transparent);
		border: 1px solid var(--box-tone);
		box-shadow: var(--shadow-drop);
	}

	.box-warm {
		--box-tone: var(--color-clay);
		--box-ink: #1b120c;
	}

	.box-head {
		display: flex;
		flex-wrap: wrap;
		justify-content: space-between;
		align-items: baseline;
		gap: 0 var(--space-sm);
		padding: 0.3rem 0.6rem;
		background: var(--box-tone);
		color: var(--box-ink);
		font-family: var(--font-body);
		font-size: 0.8125rem;
		font-weight: 800;
		letter-spacing: 0.01em;
		line-height: 1.4;
	}

	.box-head a {
		color: var(--box-ink);
		font-size: 0.72rem;
	}

	.box-body {
		padding: 0.75rem;
	}

	/* ── Profile card ── */

	.profile-card {
		padding: 0.9rem;
		border-color: var(--color-accent);
	}

	.profile-name {
		font-family: var(--font-display);
		font-size: 1.75rem;
		font-weight: 700;
		letter-spacing: -0.02em;
		line-height: 1;
		margin-bottom: 0.75rem;
	}

	.profile-id {
		display: grid;
		grid-template-columns: 8.5rem 1fr;
		gap: 0.75rem;
		align-items: start;
		margin-bottom: 1.25rem;
	}

	.profile-pic {
		position: relative;
		padding: 0.35rem;
		background: var(--color-paper-soft);
		border: 1px solid var(--color-border-strong);
	}

	.profile-pic img {
		width: 100%;
		aspect-ratio: 1;
		object-fit: contain;
	}

	.profile-pic :global(.profile-tape) {
		position: absolute;
		left: -0.75rem;
		bottom: -0.9rem;
	}

	.profile-facts {
		color: var(--color-text-soft);
		font-size: 0.75rem;
	}

	.profile-facts p + p {
		margin-top: 0.5rem;
	}

	.profile-headline {
		font-family: var(--font-hand);
		font-size: 1rem;
		line-height: 1.2;
		color: var(--color-note);
	}

	.online {
		display: inline-flex;
		align-items: center;
		gap: 0.35rem;
		color: var(--color-olive);
		font-weight: 800;
		text-transform: uppercase;
		letter-spacing: 0.04em;
	}

	.online-dot {
		width: 0.55rem;
		height: 0.55rem;
		border-radius: 50%;
		background: var(--color-olive);
		box-shadow: 0 0 0 3px color-mix(in srgb, var(--color-olive) 30%, transparent);
		animation: blink 1.2s steps(2, jump-none) infinite;
	}

	@keyframes blink {
		50% { opacity: 0.2; }
	}

	.profile-line {
		color: var(--color-text-soft);
	}

	.profile-line + .profile-line {
		margin-top: 0.4rem;
	}

	.profile-line b {
		color: var(--color-text);
	}

	/* ── Contact ── */

	.contact-grid {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 1px;
		list-style: none;
		background: var(--box-cell);
		padding: 1px;
	}

	.contact-grid a {
		display: flex;
		align-items: center;
		gap: 0.5rem;
		padding: 0.55rem 0.6rem;
		background: var(--box-cell-soft);
		font-size: 0.78rem;
	}

	.contact-grid a:hover {
		background: var(--box-cell);
	}

	.contact-icon :global(svg) {
		display: block;
		width: 1rem;
		height: 1rem;
	}

	/* ── Interests / details tables ── */

	.info-table {
		width: 100%;
		border-collapse: separate;
		border-spacing: 3px;
	}

	.info-table th,
	.info-table td {
		padding: 0.4rem 0.5rem;
		vertical-align: top;
		text-align: left;
	}

	.info-table th {
		width: 34%;
		background: var(--box-cell);
		color: var(--color-note);
		font-weight: 700;
	}

	.info-table td {
		background: var(--box-cell-soft);
		color: var(--color-text-soft);
	}

	.counter {
		display: inline-flex;
		gap: 2px;
		margin-right: 0.2rem;
	}

	.counter span {
		padding: 0 0.3rem;
		background: #080807;
		border: 1px solid var(--color-border-strong);
		color: var(--color-olive);
		font-family: var(--font-display);
		font-size: 0.72rem;
		font-weight: 600;
	}

	/* ── Pics ── */

	.pics-grid {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 0.5rem;
		list-style: none;
	}

	.pics-grid li {
		aspect-ratio: 1;
		padding: 0.25rem;
		background: #080807;
		border: 1px solid var(--color-border-strong);
	}

	.pics-grid a {
		display: block;
		height: 100%;
	}

	.pics-grid img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		object-position: top;
	}

	.pics-grid .pics-sketch {
		display: grid;
		place-items: center;
		background: var(--color-paper-soft);
	}

	/* ── Extended network (hero) ── */

	.network {
		padding: clamp(1.25rem, 3vw, 2rem);
		border: 3px double var(--color-accent);
	}

	.network-kicker {
		padding-right: 4rem;
		font-family: var(--font-display);
		font-size: 0.85rem;
		font-weight: 600;
		color: var(--color-note);
	}

	.network h1 {
		margin-top: 0.75rem;
		font-size: clamp(2.2rem, 6vw, 3.4rem);
		font-weight: 700;
		line-height: 0.95;
		letter-spacing: -0.03em;
		text-transform: lowercase;
	}

	.network-lead {
		margin-top: 1rem;
		max-width: 32rem;
		font-size: var(--text-base);
		line-height: 1.6;
		color: var(--color-text-soft);
	}

	.network :global(.network-sticker) {
		position: absolute;
		top: -1.75rem;
		right: -0.5rem;
	}

	@media (min-width: 52rem) {
		.network :global(.network-sticker) {
			right: -2rem;
		}
	}

	/* ── Blog ── */

	.blog-list {
		list-style: none;
		display: flex;
		flex-direction: column;
		gap: 0.6rem;
	}

	.blog-list li > a:first-child {
		display: block;
	}

	.blog-meta {
		color: var(--color-text-muted);
	}

	.blog-more {
		margin-left: 0.4rem;
		font-size: 0.72rem;
	}

	/* ── Blurbs (features) ── */

	.blurb-label {
		font-family: var(--font-body);
		font-size: 0.9rem;
		font-weight: 800;
		letter-spacing: 0;
		color: var(--color-clay);
	}

	.blurb-feature {
		display: grid;
		grid-template-columns: minmax(0, 1fr) 34%;
		gap: var(--space-md);
		align-items: center;
		padding-block: var(--space-lg);
		border-bottom: 1px dashed var(--color-border-strong);
	}

